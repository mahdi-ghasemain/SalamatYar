{
  "expo": {
    "name": "SalamatYar",
    "slug": "salamatyar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.salamatyar.care",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "salamatyar",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "برای نمایش مراکز درمانی اطراف، دسترسی به موقعیت شما لازم است.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "برای اسکن بارکد دارو اجازه دوربین لازم است.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
